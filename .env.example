# ==========================================
# AI TRADING SYSTEM CONFIGURATION
# ==========================================
# INSTRUCTIONS:
# 1. Rename this file to ".env" (remove the .example part)
# 2. Open the new ".env" file in a text editor.
# 3. Replace the placeholder text with your actual keys/IDs.

# --- INTERACTIVE BROKERS (IBKR) SETUP ---
# Your Paper Trading Account ID (Found in TWS/Gateway window)
# Example: DU12345
IB_ACCOUNT=DU12345

# Keep these as default if running on the same computer as TWS/Gateway
IB_HOST=127.0.0.1

# Port Settings:
# 7497 = Paper Trading (Recommended for testing)
# 7496 = Live Trading (REAL MONEY - BE CAREFUL)
# MAKE SURE your TWS/Gateway settings match this port!
IB_PORT=7497

# Client ID: Can be any number (0-999).
IB_CLIENT_ID=1

# --- AI SETUP (OPENROUTER) ---
# Get your key from: https://openrouter.ai/keys
OPENROUTER_KEY=sk-or-v1-YOUR_KEY_HERE

# The AI Model to use.
# Good options:
# - mistralai/mistral-7b-instruct (Fast, Cheap)
# - openai/gpt-4-turbo (Smart, Expensive)
# - anthropic/claude-3-opus (Very Smart, Expensive)
OPENROUTER_MODEL=mistralai/mistral-7b-instruct
